# This repository publishes eight subdirectories:
#   stimulus/            (web-based bearing-formation simulator)
#   swarm_lab_jiang_v1/  (ROS2 real-vehicle formation control project)
#   report_v1/           (experiment analysis reports and comparison tools)
#   swarm_lab_jiang_v2/  (role-based formation maneuvering: captain/first_mate/crew)
#   report_v2/           (maneuvering experiment reports, empty for now)
#   swarm_lab_jiang_v3/  (matrix-weighted Laplacian + task-driven formation control)
#   report_v3/           (task-driven formation experiment data, analysis and report)
#   swarm_lab/           (integrated official lab project: task_driven + bearing comparison)
# Everything else at the repo root stays local and untracked.
/*
!.gitignore
!README.md
!stimulus/
!swarm_lab_jiang_v1/
!report_v1/
!swarm_lab_jiang_v2/
!report_v2/
!swarm_lab_jiang_v3/
!report_v3/
!swarm_lab/

# Large raw mocap captures stay local (big binaries, not source code)
report_v1/results/videos/
report_v2/results/videos/
report_v3/v3_two1/
report_v3/v3_three1/
report_v3/v3_four1/

# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Virtual environments
.venv/
venv/
env/

# Build and packaging artifacts
build/
dist/
*.egg-info/

# Runtime output
runs/
logs/
*.log
# but archived experiment records are deliberate content, not runtime output
!report_v3/runs/

# Local editor and OS files
.idea/
.vscode/
.DS_Store
Thumbs.db
